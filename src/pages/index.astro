---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import config from "../content/config/config.json";
import client from "../../tina/__generated__/client";
import HomePage from "../../tina/pages/HomePage.tsx";
const data = await client.queries.page({ relativePath: "home.mdx" });
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={config.seo.title} description={config.seo.description} />
  </head>
  <body>
    <Header />
    <HomePage {...data} client:tina />
    <Footer />

    <script>
      const SLIDE_DURATION = 12000;

      function advance() {
        const slides = Array.from(
          document.querySelectorAll<HTMLImageElement>(".slideshow-slide"),
        );
        if (slides.length < 2) return;

        // Read the active slide from the DOM each tick so we stay in step if
        // Tina re-renders the slideshow while editing.
        const currentIndex = slides.findIndex((slide) =>
          slide.hasAttribute("data-active"),
        );
        const next = slides[(currentIndex + 1) % slides.length];

        slides.forEach((slide) => slide.removeAttribute("data-active"));
        next.setAttribute("data-active", "");
      }

      let timer = setInterval(advance, SLIDE_DURATION);

      // Clicking the slideshow advances it, and restarts the clock so the next
      // automatic change is still a full interval away.
      document.querySelector(".slideshow")?.addEventListener("click", () => {
        advance();
        clearInterval(timer);
        timer = setInterval(advance, SLIDE_DURATION);
      });
    </script>
  </body>
</html>
